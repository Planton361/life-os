# Life OS local/deployment environment placeholders.
# Do not commit real values in this file.

# Public Supabase browser-safe values.
# Required for Manual Supabase mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy fallback only if a publishable key is unavailable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only examples for future scopes.
# These are not used by the current app runtime and must never be prefixed
# with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
# AI_PROVIDER_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# EXPORT_ENCRYPTION_KEY=

# Local Playwright only.
# The auth-state file path must stay under .local/ and must not be committed.
PLAYWRIGHT_HOST=localhost
PLAYWRIGHT_PORT=3000
PLAYWRIGHT_SUPABASE_AUTH_STATE=.local/playwright/supabase-auth-state-localhost.json
